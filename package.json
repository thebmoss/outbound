{
  "name": "outbound",
  "version": "0.1.0",
  "private": false,
  "description": "A durable engine for running an outbound senior-product job search: scored targeting, a persistent relationship graph, provenance-tracked intel, and lint rules over generated materials.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx src/cli.ts validate"
  },
  "dependencies": {
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
